# Ebru AI — ortam degiskenleri ornegi
#
# Bu dosyayi .env olarak kopyalayip kendi degerlerinle doldur.
# .env dosyasi .gitignore icinde, depoya gitmez.

# ----------------------------------------------------------
# GUVENLIK
# ----------------------------------------------------------

# Colab'in tunel adresini kaydederken kullandigi gizli anahtar.
# Ayarlanmazsa her acilista rastgele uretilir ve konsola yazilir.
# Uzun ve tahmin edilemez olmali.
EBRU_REGISTER_TOKEN=buraya-uzun-rastgele-bir-metin

# Izleme ekranina erisebilecek hesabin kullanici adi.
# Bu adla kayitli kullanici giris yaptiginda yonetici sayilir.
EBRU_ADMIN_USER=boss

# Werkzeug hata ayiklayicisi. Dagitimda ASLA 1 yapma:
# ag uzerinden uzaktan kod calistirmaya izin verebilir.
# EBRU_DEBUG=0

# ----------------------------------------------------------
# KULLANIM SINIRLARI
# ----------------------------------------------------------

# Hesap basina gunluk uretim hakki
EBRU_DAILY_LIMIT=30

# Iki istek arasinda en az bekleme (saniye)
EBRU_MIN_INTERVAL=3

# Kuyrukta bekleyebilecek en fazla istek
EBRU_MAX_QUEUE=8

# Sirada en fazla bekleme suresi (saniye)
EBRU_QUEUE_TIMEOUT=240

# ----------------------------------------------------------
# URETIM
# ----------------------------------------------------------

# Yerel Stable Diffusion (AUTOMATIC1111) adresi
EBRU_LOCAL_SD_URL=http://127.0.0.1:7860

# Adim sayisi. Lightning LoRA varsa 4, yoksa 16 onerilir.
# EBRU_STEPS=4

# Nesne istendiginde LoRA agirlik tavani.
# Olcum: 0.60'a kadar nesne net kaliyor, ustunde doku onu yutuyor.
EBRU_NESNE_LORA=0.60

# ----------------------------------------------------------
# KONUM
# ----------------------------------------------------------

# Web dosyalarinin klasoru. Bos birakilirsa depo icindeki web/ kullanilir.
# EBRU_WEB_DIR=C:\yol\web
