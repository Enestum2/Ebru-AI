<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9'dan itibaren şifresiz (http://) trafik varsayılan olarak
  engelleniyor. Uygulama yerel ağdaki Flask sunucusuna http ile
  bağlandığı için bu yapılandırma gerekli.

  Güvenli varsayılan: internet üzerindeki adresler HTTPS olmak zorunda.
  Yalnızca yerel ağ adreslerine http ile bağlanılabilir.

  Kendi bilgisayarının IP'si listede yoksa aşağıya <domain> satırı
  olarak ekle. Dağıtımda sunucu HTTPS tünelin arkasında olacağı için
  bu listeye ihtiyaç kalmaz (bkz. backend/DAGITIM.md).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!--
      Dağıtımdaki sunucu HTTPS (https://ebru.ornek-adres.ts.net) olduğu
      için şifresiz trafiğe gerek yok. Aşağıdakiler yalnızca yerel
      geliştirme içindir; kendi bilgisayarının IP'sini elle test
      edeceksen buraya <domain> satırı olarak ekle.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emülatöründen ana bilgisayara erişim -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
